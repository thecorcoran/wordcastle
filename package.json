{
  "name": "word-castle-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Word Castle spelling app and reusable spaced-retrieval learning core",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/spelling",
    "build": "npm run build --workspace=packages/core && npm run build --workspace=apps/spelling",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages apps --ext .ts",
    "format:check": "prettier --check \"packages/**/*.ts\" \"apps/**/*.ts\"",
    "validate:pack": "npx tsx apps/spelling/scripts/validate-pack.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.5"
  }
}
